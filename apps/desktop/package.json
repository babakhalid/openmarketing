{
  "name": "openmarketing-desktop",
  "productName": "OpenMarketing",
  "author": {
    "name": "Youmake",
    "url": "https://youmake.dev"
  },
  "homepage": "https://openmarketing.dev",
  "private": true,
  "version": "0.1.0",
  "description": "OpenMarketing desktop app — a workspace-scoped GUI over the OpenMarketing agent runtime (RPC mode).",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5199 && cross-env OM_DESKTOP_DEV_URL=http://localhost:5199 node scripts/electron.mjs\"",
    "build": "vite build",
    "start": "vite build && node scripts/electron.mjs",
    "typecheck": "tsc --noEmit",
    "screenshot": "npm run build && node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.1.0",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  }
}
