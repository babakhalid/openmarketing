---
import Layout from "@/layouts/main.astro"
---

<Layout title="404 — OpenMarketing">
  <section class="flex flex-1 items-center justify-center px-4 py-24">
    <div class="flex flex-col items-center gap-4 text-center">
      <span class="font-mono text-sm text-mode-foreground">404</span>
      <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
      <p class="text-muted-foreground">The page you were looking for doesn't exist or has moved.</p>
      <a href="/" class="mt-2 inline-flex h-10 items-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground">Back to home</a>
    </div>
  </section>
</Layout>
